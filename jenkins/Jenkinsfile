pipeline {

    agent any

    tools {
        maven 'mymaven'
    }

    environment {
        NAME = "Milos"
    }

    parameters {
        choice choices: ['dev', 'prod'], name: 'select environment'
    }

    stages {
        stage('build') {
            steps {
                sh 'mvn clean package -DskipTests=true'
            }
        }

        stage('test') {
            parallel {
                stage('testA') {
                    steps {
                        echo "Test A"
                        sh 'mvn test'
                    }
                }

                stage('testB') {
                    steps {
                        echo "Test B"
                        sh 'mvn test'
                    }
                }
            }
        }
    }
}