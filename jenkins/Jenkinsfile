pipeline {

    agent any

    tools {
        maven 'mymaven'
    }

    environment {
        NAME = 'Milos'
    }

    stages {
        stage('build') {
            steps {
                echo 'JA SAM $NAME'
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.jar'
                }
            }
        }
    }
}